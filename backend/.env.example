# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- OTP behavior ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- JWT / sessions ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SMS provider: "mock" or "twilio" ---
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email provider: "mock" or "sendgrid" ---
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
 # --- LLM Service ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini